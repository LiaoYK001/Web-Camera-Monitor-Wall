{
  "name": "webobs-desktop",
  "version": "3.4.0-dev.0",
  "private": true,
  "description": "WebOBS full native Windows desktop client",
  "author": "WebOBS contributors",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "main": "src/main.mjs",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-runtime.mjs runtime",
    "package:dev": "electron-builder --win nsis --x64 --publish never --config builder.config.cjs",
    "package:release": "electron-builder --win nsis --x64 --publish never --config builder.config.cjs"
  },
  "dependencies": { "electron-updater": "6.8.9" },
  "devDependencies": { "electron": "44.5.1", "electron-builder": "26.15.3" }
}
