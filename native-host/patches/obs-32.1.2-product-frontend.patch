+/* Content digest of one delivered frame: sampled bytes only, never a copy of the
+ * frame. A frame whose visible timecode or markers differ changes this digest. */
+static uint32_t webobs_frame_digest(const struct obs_source_frame *f)
+{
+	if (!f || !f->data[0] || !f->linesize[0] || !f->width || !f->height)
+		return 0;
+	uint32_t hash = 2166136261U;
+	const uint32_t row_bytes = f->linesize[0] < f->width ? f->linesize[0] : f->width;
+	for (uint32_t y = 0; y < f->height; y += 17) {
+		const uint8_t *row = f->data[0] + (size_t)y * (size_t)f->linesize[0];
+		for (uint32_t x = 0; x + 3 < row_bytes; x += 31) {
+			hash = (hash ^ row[x]) * 16777619UL;
+			hash = (hash ^ row[x + 1]) * 16777619UL;
+			hash = (hash ^ row[x + 2]) * 16777619UL;
+		}
+	}
+	if (f->data[1] && f->linesize[1]) {
+		const uint8_t *row = f->data[1];
+		const uint32_t chroma_bytes = f->linesize[1] < f->width ? f->linesize[1] : f->width;
+		for (uint32_t x = 0; x + 1 < chroma_bytes; x += 41)
+			hash = (hash ^ row[x]) * 16777619UL;
+	}
+	return hash;
+}
