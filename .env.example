# Optional immutable GHCR image tag or digest. If omitted, Compose builds locally.
# WEBOBS_IMAGE=ghcr.io/owner/web-camera-monitor-wall:v0.2.0

# Base Compose publishes HTTP on host loopback. Use the production HTTPS overlay
# for LAN access; never publish the unauthenticated base listener to 0.0.0.0.
WEBOBS_BIND_ADDRESS=127.0.0.1
WEBOBS_HTTP_PORT=8080

# Use the server LAN address for browser WebRTC ICE candidates.
WEBOBS_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1
WEBOBS_WEBRTC_UDP_PORT=8189

# Optional infrastructure switches. Cameras and daily settings belong in WebUI.
WEBOBS_NVR_ENABLED=false

# AMD/Intel render-node overlay (compose.m6-vaapi.yaml).
WEBOBS_VAAPI_DEVICE=/dev/dri/renderD128
WEBOBS_VIDEO_ENCODER=auto
WEBOBS_RENDERER=auto
WEBOBS_HARDWARE_DECODE=auto

# Production HTTPS/auth secret sources (Git-ignored local files).
# WEBOBS_TLS_SERVER_NAME=monitor.example.com
# WEBOBS_TLS_PUBLIC_AUTHORITY=monitor.example.com:443
# WEBOBS_HTTPS_PORT=443
# WEBOBS_TLS_CERTIFICATE_SOURCE=./secrets/webobs-tls-certificate.pem
# WEBOBS_TLS_PRIVATE_KEY_SOURCE=./secrets/webobs-tls-private-key.pem
# WEBOBS_AUTH_USERNAME_SOURCE=./secrets/webobs-auth-username.txt
# WEBOBS_AUTH_PASSWORD_SOURCE=./secrets/webobs-auth-password.txt
# WEBOBS_CONTROL_ALLOWED_ORIGINS=https://monitor.example.com
# Exact HTTPS camera origins eligible for PWA WHEP/HLS/MJPEG; never use a wildcard.
# WEBOBS_PWA_MEDIA_ALLOWED_ORIGINS=https://camera-a.example.com,https://camera-b.example.com:8443
# Exact browser-facing Origin used for server-side CORS qualification; required for PWA True Direct.
# WEBOBS_PWA_PUBLIC_ORIGIN=https://monitor.example.com:28777
# WEBOBS_TURN_URL=turn:turn.example.com:3478?transport=tcp
# WEBOBS_TURN_USERNAME_SOURCE=./secrets/webobs-turn-username.txt
# WEBOBS_TURN_PASSWORD_SOURCE=./secrets/webobs-turn-password.txt

WEBOBS_LOG_MAX_SIZE=10m
WEBOBS_LOG_MAX_FILES=3
# Runtime role: standalone (default), controller, recorder, or worker.
# Recorder/worker roles disable the public control listener unless explicitly overridden.
WEBOBS_NODE_ROLE=standalone

# v2.3 multi-node control plane. Keep cluster port private/VPN-only. Controller
# certificates and the cluster CA key must be mounted as container Secrets.
# WEBOBS_CLUSTER_LISTEN=false
# WEBOBS_CLUSTER_PORT=9443
# WEBOBS_CLUSTER_SERVER_CERT_FILE=/run/secrets/webobs_cluster_server_certificate
# WEBOBS_CLUSTER_SERVER_KEY_FILE=/run/secrets/webobs_cluster_server_private_key
# WEBOBS_CLUSTER_CLIENT_CA_FILE=/run/secrets/webobs_cluster_ca_certificate
# WEBOBS_CLUSTER_CA_CERT_FILE=/run/secrets/webobs_cluster_ca_certificate
# WEBOBS_CLUSTER_CA_KEY_FILE=/run/secrets/webobs_cluster_ca_private_key
# Set false after a database administrator exists to disable emergency Basic Auth.
# WEBOBS_COMPAT_BASIC_AUTH=true

# Recorder/worker enrollment. The id/token are ten-minute one-time values copied
# from the administrator workspace and must not be committed or placed in logs.
# WEBOBS_CONTROLLER_URL=https://controller.example.test:9443
# WEBOBS_CLUSTER_CA_FILE=/run/secrets/webobs_cluster_ca_certificate
# WEBOBS_NODE_NAME=recorder-a
# WEBOBS_NODE_ENROLLMENT_ID=<one-time-id>
# WEBOBS_NODE_ENROLLMENT_TOKEN=<one-time-token>
# WEBOBS_VOLUMES_ROOT=/recordings/volumes

# Optional S3-compatible archive. archive.json may only reference credentials
# below /run/secrets; never place access keys directly in this environment file.
# WEBOBS_ARCHIVE_ENABLED=false
# WEBOBS_ARCHIVE_CONFIG=/config/webobs/archive.json
# WEBOBS_ARCHIVE_CA_FILE=/run/secrets/webobs_archive_ca
# WEBOBS_ARCHIVE_RETRIEVAL_ENABLED=true
# WEBOBS_ARCHIVE_CACHE_MAX_BYTES=2147483648

# Optional 15-minute encrypted configuration backups. The key is an independent
# raw 32-byte Secret and must not be reused for TLS, cluster CA, or camera access.
# WEBOBS_ENCRYPTED_BACKUP_ENABLED=false
# WEBOBS_BACKUP_KEY_FILE=/run/secrets/webobs_backup_key
# WEBOBS_BACKUP_ROOT=/backups
