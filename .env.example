# Copy this file to .env and replace the URL. The real .env file is ignored.
WEBOBS_RTSP_URL=rtsp://user:password@192.168.1.10:554/stream
# The URL bootstraps this file only when it does not exist. Later starts load it.
WEBOBS_SCENE_FILE=/config/webobs/scene.json
# Base Compose publishes this port on host loopback only.
WEBOBS_HTTP_PORT=8080
# Keep loopback for local-only access. Remote access requires the M6 auth overlay and trusted HTTPS termination.
WEBOBS_BIND_ADDRESS=127.0.0.1
# Optional M6 file-auth overlay. Create both local files under the Git-ignored secrets/ directory.
# WEBOBS_AUTH_USERNAME_SOURCE=./secrets/webobs-auth-username.txt
# WEBOBS_AUTH_PASSWORD_SOURCE=./secrets/webobs-auth-password.txt
# WEBOBS_AUTH_FAILURE_LIMIT=5
# WEBOBS_AUTH_FAILURE_WINDOW_SECONDS=60
# List only externally visible HTTPS origins terminated by a trusted reverse proxy.
# WEBOBS_CONTROL_ALLOWED_ORIGINS=https://monitor.example.com
# M2 runs MediaMTX inside the product container. Set this to false only for diagnostics.
WEBOBS_WEBRTC_ENABLED=true
WEBOBS_WHIP_URL=http://127.0.0.1:8889/program/whip
# Use the host LAN address when browsers connect from other devices. Comma-separate multiple candidates.
WEBOBS_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1
WEBOBS_WEBRTC_UDP_PORT=8189
# Browser sources are denied unless their exact origin is listed here.
# Comma-separate trusted origins only; never include credentials, paths, queries, or fragments.
# WEBOBS_BROWSER_ALLOWED_ORIGINS=https://dashboard.example
# Keep false unless an allowlisted dashboard intentionally lives on a trusted private network.
WEBOBS_BROWSER_ALLOW_PRIVATE_NETWORKS=false
# Leave unset for /recordings/webobs-<UTC timestamp>.mp4
# WEBOBS_OUTPUT=/recordings/camera.mp4
WEBOBS_DURATION_SECONDS=0
WEBOBS_WIDTH=1920
WEBOBS_HEIGHT=1080
WEBOBS_FPS=30
WEBOBS_BITRATE_KBPS=6000
WEBOBS_CONNECT_TIMEOUT_SECONDS=20
WEBOBS_RTSP_TRANSPORT=tcp
WEBOBS_LOG_LEVEL=info
# A visible source becomes unhealthy after this many seconds without a new frame.
WEBOBS_SOURCE_STALE_SECONDS=10
# Automatic RTSP restarts use exponential backoff bounded by these values.
WEBOBS_SOURCE_RECOVERY_BASE_SECONDS=5
WEBOBS_SOURCE_RECOVERY_MAX_SECONDS=60
# Product Compose bounds Docker's json-file logs. Keep both values finite.
WEBOBS_LOG_MAX_SIZE=10m
WEBOBS_LOG_MAX_FILES=3
