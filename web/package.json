{
  "name": "webobs-editor",
  "private": true,
  "version": "2.3.0-dev",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:pwa": "playwright test",
    "test:local": "playwright test -c playwright.local.config.ts --project=chromium",
    "test:local:chrome": "playwright test -c playwright.local.config.ts --project=chrome",
    "test:iwa": "tsc -p experiments/iwa/tsconfig.worker.json && tsc -p experiments/iwa/tsconfig.runtime.json"
  },
  "dependencies": {
    "hls.js": "1.7.1",
    "libsodium-wrappers": "0.8.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
